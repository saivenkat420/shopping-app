{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/api/products/:id",
      "destination": "/api/product-details?id=:id"
    },
    {
      "source": "/((?!api/|static/|img/|manifest\\.json|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
